# Rustman writes LF; golden fixtures and docs examples are compared byte for byte.
*.rman.yaml text eol=lf
_collection.yaml text eol=lf
crates/rustman-core/tests/fixtures/** text eol=lf
crates/rustman-import/tests/fixtures/** text eol=lf
docs/*.md text eol=lf
# insta snapshots (reporters, help output).
*.snap text eol=lf
# Templates and schemas embedded with include_str!: their bytes are output.
*.j2 text eol=lf
docs/schemas/*.json text eol=lf
crates/rustman-viz-protocol/schema/*.json text eol=lf
