---
source: crates/rustman-monitor/src/recipe/tests.rs
expression: "all(\"{cron: \\\"0,30 9 * * 1-5\\\", tz: Europe/Lisbon}\")"
---
===== Cron
# Run the api-health monitor (cron 0,30 9 * * 1-5 (Europe/Lisbon)). Install with: crontab -e
CRON_TZ=Europe/Lisbon
0,30 9 * * 1-5 cd /srv/ws && /usr/local/bin/rustman monitor run api-health
===== Systemd
# ~/.config/systemd/user/rustman-monitor-api-health.service
[Unit]
Description=Rustman monitor api-health

[Service]
Type=oneshot
WorkingDirectory=/srv/ws
ExecStart=/usr/local/bin/rustman monitor run api-health

# ~/.config/systemd/user/rustman-monitor-api-health.timer
# Enable with: systemctl --user enable --now rustman-monitor-api-health.timer
[Unit]
Description=Run the Rustman monitor api-health (cron 0,30 9 * * 1-5 (Europe/Lisbon))

[Timer]
OnCalendar=Mon,Tue,Wed,Thu,Fri *-*-* 9:0,30:00 Europe/Lisbon
Persistent=false

[Install]
WantedBy=timers.target
