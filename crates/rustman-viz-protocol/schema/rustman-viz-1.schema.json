{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CyberdyneCorp/rustman/schema/rustman-viz-1.schema.json",
  "title": "rustman-viz/1 message",
  "description": "One line of the Rustman viz protocol. Unknown message types and unknown fields are allowed and ignored by readers.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "protocol",
          "producer"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "pattern": "^rustman-viz/[0-9]+"
          },
          "producer": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello_ack"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "protocol",
          "viewer"
        ],
        "properties": {
          "protocol": {
            "type": "string"
          },
          "viewer": {
            "type": "string"
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "run_dashboard, exploration_dashboard, api_graph, response_inspector, bench"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello_reject"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "supported"
        ],
        "properties": {
          "supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "open_view"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "type": "string",
            "description": "run_dashboard, exploration_dashboard, api_graph, response_inspector, bench, stress, monitor_trend, chain_probe"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_started"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "started_at"
        ],
        "properties": {
          "started_at": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "exchange_completed"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "request",
          "method",
          "url",
          "outcome",
          "duration_ms"
        ],
        "properties": {
          "request": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "description": "passed, failed, errored, cancelled, skipped (unknown values are allowed)"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 999
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "assertions": {
            "type": "object",
            "required": [
              "passed",
              "failed"
            ],
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "error": {
            "type": "string"
          },
          "iteration": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_finished"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "state",
          "summary"
        ],
        "properties": {
          "state": {
            "type": "string",
            "description": "completed or aborted"
          },
          "summary": {
            "type": "object",
            "required": [
              "total",
              "passed",
              "failed",
              "errored",
              "skipped",
              "duration_ms"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "errored": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "exploration_started"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "started_at",
          "operations"
        ],
        "properties": {
          "started_at": {
            "type": "string"
          },
          "operations": {
            "type": "integer",
            "minimum": 0
          },
          "base_url": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe_completed"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "operation",
          "outcome",
          "duration_ms"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "description": "passed, failed, errored, cancelled, skipped (unknown values are allowed)"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 999
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "finding"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "severity",
          "operation",
          "title"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "description": "critical, high, medium, low, info"
          },
          "operation": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "exploration_finished"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "state",
          "operations_total",
          "operations_exercised"
        ],
        "properties": {
          "state": {
            "type": "string",
            "description": "completed or aborted"
          },
          "operations_total": {
            "type": "integer",
            "minimum": 0
          },
          "operations_exercised": {
            "type": "integer",
            "minimum": 0
          },
          "status_codes_documented": {
            "type": "integer",
            "minimum": 0
          },
          "status_codes_seen": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "load_report"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "run, exploration or bench"
          },
          "view": {
            "type": "string",
            "description": "run_dashboard, exploration_dashboard, api_graph, response_inspector, bench"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "bench_tick"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "second",
          "elapsed_ms",
          "active_vus",
          "requests",
          "errors",
          "rps",
          "p50_ms",
          "p95_ms",
          "p99_ms"
        ],
        "properties": {
          "second": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "remaining_ms": {
            "type": "integer",
            "minimum": 0
          },
          "active_vus": {
            "type": "integer",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "rps": {
            "type": "number",
            "minimum": 0
          },
          "p50_ms": {
            "type": "number",
            "minimum": 0
          },
          "p95_ms": {
            "type": "number",
            "minimum": 0
          },
          "p99_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "bench_finished"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "state",
          "duration_ms",
          "iterations",
          "requests",
          "errors",
          "rps",
          "p50_ms",
          "p95_ms",
          "p99_ms"
        ],
        "properties": {
          "state": {
            "type": "string",
            "description": "completed or aborted"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "iterations": {
            "type": "integer",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "rps": {
            "type": "number",
            "minimum": 0
          },
          "p50_ms": {
            "type": "number",
            "minimum": 0
          },
          "p95_ms": {
            "type": "number",
            "minimum": 0
          },
          "p99_ms": {
            "type": "number",
            "minimum": 0
          },
          "thresholds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "expression",
                "passed",
                "actual"
              ],
              "properties": {
                "expression": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "actual": {
                  "type": "string"
                }
              }
            }
          },
          "aborted": {
            "type": "string",
            "description": "threshold or interrupted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inspect_response"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "request": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "content_type": {
            "type": "string"
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "selector": {
            "type": "string"
          },
          "body": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "inline"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "path",
                  "bytes"
                ],
                "properties": {
                  "type": {
                    "const": "blob_ref"
                  },
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "media_type": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "blob_ref"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "path",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "close"
          }
        }
      },
      "then": {
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "monitor_trend"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "monitor",
          "environment",
          "schedule"
        ],
        "properties": {
          "monitor": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "schedule": {
            "type": "string"
          },
          "uptime_24h": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "uptime_7d": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "uptime_30d": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "latency": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "hour",
                "p95_ms"
              ],
              "properties": {
                "hour": {
                  "type": "string"
                },
                "p95_ms": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "hour_of_day": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "hour",
                "passed",
                "failed",
                "errored",
                "skipped"
              ],
              "properties": {
                "hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "errored": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe_latency"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "provider",
          "method",
          "samples",
          "p50_ms",
          "p95_ms",
          "max_ms"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "samples": {
            "type": "integer",
            "minimum": 0
          },
          "p50_ms": {
            "type": "number",
            "minimum": 0
          },
          "p95_ms": {
            "type": "number",
            "minimum": 0
          },
          "max_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "chain_block"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "provider",
          "number",
          "timestamp",
          "gas_used",
          "gas_limit"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0
          },
          "gas_used": {
            "type": "integer",
            "minimum": 0
          },
          "gas_limit": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "call_trace"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "provider",
          "nodes"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "parent": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "gas_used": {
                  "type": "integer",
                  "minimum": 0
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}
