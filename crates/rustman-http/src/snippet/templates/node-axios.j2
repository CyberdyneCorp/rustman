{% if auth_comment %}
// {{ auth_comment }}
{% endif %}
import axios from "axios";
{% if body.any_file %}
import { openAsBlob } from "node:fs";
{% endif %}
{% if body.kind == "file" %}
import { readFile } from "node:fs/promises";
{% endif %}
{% if constants %}

{% for c in constants %}
const {{ c.name }} = {{ c.value | lit }};
{% endfor %}
{% endif %}

{% if body.kind == "multipart" %}
const form = new FormData();
{% for p in body.parts %}
{% if p.is_file %}
form.append({{ p.name | lit }}, await openAsBlob({{ p.path | q }}, { type: {{ p.content_type | lit }} }), {{ p.filename | lit }});
{% elif p.content_type %}
form.append({{ p.name | lit }}, new Blob([{{ p.value | q }}], { type: {{ p.content_type | lit }} }));
{% else %}
form.append({{ p.name | lit }}, {{ p.value | q }});
{% endif %}
{% endfor %}

{% endif %}
const response = await axios.request({
  method: {{ method | lit }},
  url: {{ url | q }},
{% if headers %}
  headers: {
{% for h in headers %}
    {{ h.name | lit }}: {{ h.value | hv }},
{% endfor %}
  },
{% endif %}
{% if body.kind == "text" and body.is_json and body.code %}
  data: {{ body.code }},
{% elif body.kind == "text" %}
  data: {{ body.text | q }},
{% elif body.kind == "file" %}
  data: await readFile({{ body.path | q }}),
{% elif body.kind == "multipart" %}
  data: form,
{% endif %}
{% if not follow_redirects %}
  maxRedirects: 0,
{% endif %}
  responseType: "text",
  validateStatus: () => true,
});
console.log(response.status);
console.log(response.data);
