{% if auth_comment %}
// {{ auth_comment }}
{% endif %}
// Cargo.toml: reqwest = { version = "0.12", features = ["blocking"{% if body.kind == "multipart" %}, "multipart"{% endif %}] }
{% if body.kind == "multipart" %}
use reqwest::blocking::multipart::{Form, Part};
{% endif %}
{% if constants %}

{% for c in constants %}
const {{ c.name }}: &str = {{ c.value | lit }};
{% endfor %}
{% endif %}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = reqwest::blocking::Client::builder()
{% if not follow_redirects %}
        .redirect(reqwest::redirect::Policy::none())
{% endif %}
{% if not verify_tls %}
        .danger_accept_invalid_certs(true)
{% endif %}
        .build()?;
{% if body.kind == "multipart" %}
    let form = Form::new()
{% for p in body.parts %}
{% if p.is_file %}
        .part({{ p.name | lit }}, Part::file({{ p.path | q }})?.mime_str({{ p.content_type | lit }})?)
{% elif p.content_type %}
        .part({{ p.name | lit }}, Part::text({{ p.value | q }}).mime_str({{ p.content_type | lit }})?)
{% else %}
        .text({{ p.name | lit }}, {{ p.value | q }})
{% endif %}
{% endfor %}
        ;
{% endif %}
    let response = client
{% if standard_method %}
        .request(reqwest::Method::{{ method }}, {{ url | q }})
{% else %}
        .request(reqwest::Method::from_bytes({{ method | lit }}.as_bytes())?, {{ url | q }})
{% endif %}
{% for h in headers %}
        .header({{ h.name | lit }}, {{ h.value | hv }})
{% endfor %}
{% if body.kind == "text" %}
        .body({{ body.text | q }})
{% elif body.kind == "file" %}
        .body(std::fs::File::open({{ body.path | q }})?)
{% elif body.kind == "multipart" %}
        .multipart(form)
{% endif %}
        .send()?;
    println!("{}", response.status());
    println!("{}", response.text()?);
    Ok(())
}
