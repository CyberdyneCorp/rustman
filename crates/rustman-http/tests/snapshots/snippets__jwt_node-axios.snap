// jwt auth: sign a JWT and send it as a bearer token
import axios from "axios";

const response = await axios.request({
  method: "GET",
  url: "https://api.example/private",
  responseType: "text",
  validateStatus: () => true,
});
console.log(response.status);
console.log(response.data);
