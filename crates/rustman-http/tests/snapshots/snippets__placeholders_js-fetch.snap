const BASE_URL = "https://api.example";

const response = await fetch(BASE_URL + "/users?notify=yes", {
  method: "POST",
  headers: {
    "Accept": "application/json",
    "X-Request-Id": "abc 123",
    "Authorization": "Bearer «redacted:api_token»",
    "Content-Type": "application/json",
  },
  body: JSON.stringify({"name": "Ada Lovelace", "admin": true, "teams": ["core", 7], "manager": null}),
});
console.log(response.status);
console.log(await response.text());
