package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"net/textproto"
	"os"
)

func main() {
	body := &bytes.Buffer{}
	form := multipart.NewWriter(body)
	if err := form.WriteField("caption", "It's me"); err != nil {
		panic(err)
	}
	part2, err := form.CreatePart(textproto.MIMEHeader{
		"Content-Disposition": {"form-data; name=\"meta\""},
		"Content-Type":        {"application/json"},
	})
	if err != nil {
		panic(err)
	}
	if _, err := part2.Write([]byte("{\"v\":1}")); err != nil {
		panic(err)
	}
	part3, err := form.CreatePart(textproto.MIMEHeader{
		"Content-Disposition": {"form-data; name=\"file\"; filename=\"avatar.png\""},
		"Content-Type":        {"image/png"},
	})
	if err != nil {
		panic(err)
	}
	data3, err := os.ReadFile("files/avatar.png")
	if err != nil {
		panic(err)
	}
	if _, err := part3.Write(data3); err != nil {
		panic(err)
	}
	if err := form.Close(); err != nil {
		panic(err)
	}

	req, err := http.NewRequest("PUT", "https://api.example/users/42/avatar", body)
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-Trace", "t-1")
	req.Header.Set("Content-Type", form.FormDataContentType())

	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	data, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(data))
}
