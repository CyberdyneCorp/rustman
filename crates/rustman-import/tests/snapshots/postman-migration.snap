# pm.variables.set("total", order.order["grand total"]);
# pm.expect(order.order.status).to.not.eql("failed");
# _.each(order.items, (i) => pm.expect(i.qty).to.be.above(0));
# pm.sendRequest("https://audit.example.com/log", () => {});
# pm.expect(order.order.lines).to.have.lengthOf(3);
# var tax = order.order.total * 0.2;
# pm.expect(tax).to.be.below(100);
# pm.expect(order.order.id).to.exist;
version: 1
kind: http
name: Checkout
method: POST
url: '{{base_url}}/checkout'
assertions:
  - status: 201
  - json:
      path: $.order.status
      not_equals: failed
  - json:
      path: $.order.lines
      length: 3
  - json:
      path: $.order.id
      exists: true
captures:
  - var: orderId
    from: json
    path: $.order.id
  - var: total
    from: json
    path: $.order["grand total"]
