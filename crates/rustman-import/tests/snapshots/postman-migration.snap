#     pm.response.to.have.header("X-Total-Count");
#     const d = pm.response.json();
#     pm.expect(d.items[0].tags).to.have.lengthOf(2);
#     pm.expect(d.items).to.be.an("array");
#     pm.expect(d.total).to.be.above(0);
#     pm.expect(d.page).to.eql(1);
#     pm.expect(pm.response.json().items.every(i => i.price > 0)).to.be.true;
#     pm.expect(d.items.length).to.eql(20);
#     pm.collectionVariables.set("firstId", d.items[0].id);
# });
version: 1
kind: http
name: List orders
method: GET
url: '{{base_url}}/orders'
assertions:
  - status: '2xx'
  - header:
      name: Content-Type
      equals: application/json
  - header:
      name: X-Total-Count
      exists: true
  - json:
      path: $.items[0].tags
      length: 2
  - json:
      path: $.items
      type: array
  - json:
      path: $.total
      gt: 0
  - json:
      path: $.page
      equals: 1
  - json:
      path: $.items
      length: 20
captures:
  - var: firstId
    from: json
    path: $.items[0].id
=== shop-scripts/get-user.rman.yaml (create)
# imported-script: test (not executed)
# const user = pm.response.json();
# pm.expect(user.user.id).to.eql(42);
# pm.expect(user.user.name).to.be.a('string');
# pm.expect(user.user.email).to.exist;
# pm.expect(pm.response.text()).to.include("Ada");
# pm.expect(pm.response.code).to.equal(200);
# if (user.user.admin) {
#     postman.setNextRequest("Admin panel");
# }
# pm.expect(user.user.roles).to.include("viewer");
version: 1
kind: http
name: Get user
method: GET
url: '{{base_url}}/users/42'
assertions:
  - json:
      path: $.user.id
      equals: 42
  - json:
      path: $.user.name
      type: string
  - json:
      path: $.user.email
      exists: true
  - body:
      contains: Ada
  - status: 200
  - json:
      path: $.user.roles
      contains: viewer
