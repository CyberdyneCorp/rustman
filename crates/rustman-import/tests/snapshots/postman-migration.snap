=== shop-scripts/login.rman.yaml (create)
# imported-script: prerequest (not executed)
# pm.variables.set("ts", Date.now());
# pm.request.headers.add({key: "X-Token", value: "«redacted:token»"});
# imported-script: test (not executed)
# pm.test("ok", () => pm.response.to.have.status(200));
# const body = pm.response.json();
# pm.environment.set("token", body.data.token);
# pm.environment.set("etag", pm.response.headers.get("ETag"));
# pm.globals.set("session", pm.cookies.get("sid"));
# pm.test("fast", () => pm.expect(pm.response.responseTime).to.be.below(300));
# pm.expect(body.data.expires_in).to.be.above(60);
version: 1
kind: http
name: Login
method: POST
url: '{{base_url}}/auth/login'
assertions:
  - status: 200
  - latency:
      total_lt: 300
  - json:
      path: $.data.expires_in
      gt: 60
captures:
  - var: token
    from: json
    path: $.data.token
    persist: true
  - var: etag
    from: header
    name: ETag
    persist: true
  - var: session
    from: cookie
    name: sid
    persist: true
=== shop-scripts/list-orders.rman.yaml (create)
