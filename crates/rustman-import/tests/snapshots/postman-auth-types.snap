method: GET
url: '{{base_url}}/ntlm'
auth:
  type: none
=== auth-types/_collection.yaml (create)
name: Auth types
order:
  - no-auth
  - basic
  - bearer
  - api-key-in-query
  - oauth2-client-credentials
  - oauth2-authorization-code
  - oauth2-implicit
  - hawk
  - digest
  - aws-signature
  - ntlm
variables:
  base_url: http://localhost:8080
