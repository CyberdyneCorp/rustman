=== shop-capture/api-example-com/get-v1-products.rman.yaml (create)
version: 1
kind: http
name: GET /v1/products
method: GET
url: https://api.example.com/v1/products
query:
  - name: page
    value: '1'
  - name: size
    value: '20'
headers:
  - name: accept
    value: application/json
  - name: user-agent
    value: Mozilla/5.0
  - name: authorization
    value: Bearer {{authorization_token}}
  - name: cookie
    value: '{{cookie}}'
=== shop-capture/api-example-com/post-v1-cart.rman.yaml (create)
version: 1
kind: http
name: POST /v1/cart
method: POST
url: https://api.example.com/v1/cart
headers:
  - name: accept
    value: application/json
  - name: user-agent
    value: Mozilla/5.0
  - name: authorization
    value: Bearer {{authorization_token}}
  - name: cookie
    value: '{{cookie}}'
  - name: content-type
    value: application/json
body:
  type: json
  content: '{"product": 7, "qty": 2, "card_token": "{{card_token}}"}'
