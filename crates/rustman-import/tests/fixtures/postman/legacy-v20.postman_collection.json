{
  "info": {
    "name": "Legacy v2.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": { "username": "admin", "password": "{{admin_password}}" }
  },
  "item": [
    {
      "name": "Status",
      "request": "https://legacy.example.com/status?verbose=1"
    },
    {
      "name": "Search",
      "request": {
        "method": "post",
        "header": "Content-Type: application/json\nX-Trace: on",
        "body": { "mode": "raw", "raw": "{\"q\": \"{{query}}\"}" },
        "url": "https://legacy.example.com/search",
        "auth": { "type": "bearer", "bearer": { "token": "CANARY-v20-bearer-8642" } }
      }
    },
    {
      "name": "Built URL",
      "request": {
        "method": "GET",
        "url": {
          "protocol": "https",
          "host": ["api", "legacy", "example", "com"],
          "port": "8443",
          "path": ["v2", "items"]
        }
      }
    }
  ]
}
