<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ title }}</title>
<style>{{ css | safe }}</style>
</head>
<body>
<h1>{{ title }}</h1>
{% if kind == "exploration" -%}
<dl class="meta">
<dt>Target</dt><dd><code>{{ r.target }}</code></dd>
<dt>Document</dt><dd><code>{{ r.spec }}</code></dd>
<dt>Environment</dt><dd>{{ r.environment or "none" }}</dd>
<dt>Seed</dt><dd>{{ r.seed }}</dd>
<dt>Started</dt><dd>{{ r.started_at }}</dd>
<dt>Finished</dt><dd>{{ r.finished_at }}</dd>
<dt>Duration</dt><dd>{{ duration }}</dd>
<dt>Safety</dt><dd>{{ safety }}</dd>
</dl>

<h2>Summary</h2>
<p>{{ failing }} finding{{ "" if failing == 1 else "s" }} at or above <strong>{{ fail_on }}</strong>. Findings by severity: {{ counts }}.</p>
<table>
<thead><tr><th class="n">Probes</th><th class="n">Passed</th><th class="n">Finding</th><th class="n">Blocked</th><th class="n">Skipped</th><th class="n">Not run</th><th class="n">Failed</th></tr></thead>
<tbody><tr><td class="n">{{ p.total }}</td><td class="n">{{ p.passed }}</td><td class="n">{{ p.finding }}</td><td class="n">{{ p.blocked }}</td><td class="n">{{ p.skipped }}</td><td class="n">{{ p.not_run }}</td><td class="n">{{ p.failed }}</td></tr></tbody>
</table>

<h2>Findings</h2>
{% if findings -%}
<div class="filters" id="filters" hidden>
<label>Severity<select id="filter-severity"><option value="">all</option>{% for s in severities %}<option value="{{ s }}">{{ s }}</option>{% endfor %}</select></label>
<label>Operation<select id="filter-operation"><option value="">all</option>{% for o in finding_operations %}<option value="{{ o }}">{{ o }}</option>{% endfor %}</select></label>
</div>
{% for f in findings -%}
<details class="finding" data-severity="{{ f.severity }}" data-operation="{{ f.operation }}">
<summary><span class="sev sev-{{ f.severity }}">{{ f.severity }}</span> <span>{{ f.id }}</span> <strong>{{ f.rule }}</strong> <span class="op">{{ f.operation }}</span> <span class="muted">{{ f.occurrences }}&times;</span></summary>
<div>
<p>{{ f.message }}</p>
<p class="muted">{{ f.description }}{% if f.remediation %} Remediation: {{ f.remediation }}{% endif %}</p>
{% if f.instance_pointer %}<p class="muted">Instance <code>{{ f.instance_pointer }}</code>, schema <code>{{ f.schema_pointer }}</code></p>{% endif %}
<p>Request</p>
<pre>{{ f.request_text }}</pre>
<p>Response{% if f.evidence.truncated %} (body truncated){% endif %}</p>
<pre>{{ f.response_text }}</pre>
{% if f.reproduction %}<p>Reproduce</p>
<pre>{{ f.reproduction.curl }}</pre>{% endif %}
</div>
</details>
{% endfor %}
{%- else -%}
<p>No findings.</p>
{%- endif %}

<h2>Coverage</h2>
<p>Operations exercised: {{ c.operations.covered }}/{{ c.operations.total }} ({{ c.operations.percent }}%). Documented statuses observed: {{ c.statuses.covered }}/{{ c.statuses.total }} ({{ c.statuses.percent }}%).</p>
<table>
<thead><tr><th>Operation</th><th>Statuses</th></tr></thead>
<tbody>
{% for row in c.matrix -%}
<tr><td><code>{{ row.operation }}</code></td><td>{% for s in row.statuses %}<span class="state-{{ s.state }}">{{ s.status }} {{ s.class if s.class else s.state }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
{% endfor -%}
</tbody>
</table>
{% if r.left_behind -%}
<h2>Left behind</h2>
<ul>
{% for res in r.left_behind -%}
<li><code>{{ res.url }}</code> <span class="muted">created by {{ res.operation }}{% if res.delete %}; delete with {{ res.delete }}{% endif %}</span></li>
{% endfor -%}
</ul>
{%- endif %}
<script>{{ js | safe }}</script>
{%- elif kind == "contract" -%}
<dl class="meta">
{% for s in r.sources -%}
<dt>{{ s.role | capitalize }}</dt><dd><code>{{ s.name }}</code></dd>
{% endfor -%}
{% if r.catalog_version %}<dt>Rule catalog</dt><dd>version {{ r.catalog_version }}</dd>{% endif %}
</dl>

<h2>Summary</h2>
<p>{{ summary }}. <strong class="status-{{ "passed" if r.summary.passed else "failed" }}">{{ "Passed" if r.summary.passed else "Failed" }}</strong>: {{ r.summary.failing }} failing.</p>
{% for g in groups -%}
<h2>{{ g.status | capitalize }} ({{ g.items | length }})</h2>
<table>
<thead><tr><th>Rule</th><th>{{ subject }}</th><th>Description</th><th>Pointer</th></tr></thead>
<tbody>
{% for i in g.items -%}
<tr><td><code>{{ i.rule }}</code>{% if i.allowed %} <span class="muted">(allowed: {{ i.allowed }})</span>{% elif i.failing %} <span class="status-failed">(failing)</span>{% endif %}</td><td><code>{{ i.subject }}</code></td><td>{{ i.message }}</td><td><code>{{ i.pointer }}</code></td></tr>
{% endfor -%}
</tbody>
</table>
{% endfor -%}
{% if r.warnings -%}
<h2>Warnings</h2>
<ul>
{% for w in r.warnings %}<li>{{ w }}</li>
{% endfor -%}
</ul>
{%- endif %}
{%- elif kind == "bench" -%}
<dl class="meta">
<dt>Target</dt><dd><code>{{ r.target }}</code></dd>
<dt>Environment</dt><dd>{{ r.environment or "none" }}</dd>
<dt>Executor</dt><dd>{{ r.profile.executor }}</dd>
<dt>Started</dt><dd>{{ r.started_at }}</dd>
<dt>Duration</dt><dd>{{ duration }}</dd>
{% if r.aborted %}<dt>Aborted</dt><dd class="status-failed">{{ r.aborted }}: the results are partial</dd>{% endif %}
</dl>

<h2>Summary</h2>
<p><strong class="status-{{ "passed" if passed else "failed" }}">{{ "Passed" if passed else "Failed" }}</strong>: {{ r.totals.iterations }} iterations ({{ r.totals.interrupted }} interrupted{% if r.totals.scheduled %}, {{ r.totals.scheduled }} scheduled, {{ r.totals.dropped }} dropped{% endif %}), {{ r.overall.requests }} requests ({{ "%.1f" | format(r.totals.rps) }}/s).</p>
{% if thresholds -%}
<ul class="thresholds">
{% for t in thresholds %}<li>{{ t }}</li>
{% endfor -%}
</ul>
{%- endif %}

{% for c in charts -%}
<h2>{{ c.title }}</h2>
<figure class="chart">
<svg viewBox="-4 -4 {{ c.chart.width + 8 }} {{ c.chart.height + 8 }}" preserveAspectRatio="none" role="img" aria-label="{% for l in c.chart.lines %}{{ l.name }}{% if not loop.last %}, {% endif %}{% endfor %} per second">
<line class="axis" x1="0" y1="{{ c.chart.height }}" x2="{{ c.chart.width }}" y2="{{ c.chart.height }}"/>
{% for l in c.chart.lines -%}
<polyline class="line line-{{ l.name }}" points="{{ l.points }}"/>
{% endfor -%}
</svg>
<figcaption><span class="muted">top {{ c.chart.top }}, {{ c.chart.end }}</span>{% for l in c.chart.lines %} <span class="key line-{{ l.name }}">{{ l.name }}</span>{% endfor %}</figcaption>
</figure>
{% endfor %}

<h2>Latency ({{ latency_kind }}, ms)</h2>
<table>
<thead><tr><th>File</th><th class="n">min</th><th class="n">avg</th><th class="n">p50</th><th class="n">p90</th><th class="n">p95</th><th class="n">p99</th><th class="n">max</th><th class="n">Requests</th><th>Errors</th></tr></thead>
<tbody>
{% for row in rows -%}
<tr><td><code>{{ row.name }}</code></td><td class="n">{{ "%.2f" | format(row.s.latency.min_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.latency.avg_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.latency.p50_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.latency.p90_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.latency.p95_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.latency.p99_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.latency.max_ms) }}</td><td class="n">{{ row.s.requests }}</td><td>{{ row.error_rate }}{% if row.errors %} <span class="muted">({{ row.errors }})</span>{% endif %}</td></tr>
{% endfor -%}
</tbody>
</table>
{% if samples -%}
<h2>Error samples</h2>
<table>
<thead><tr><th>Class</th><th>File</th><th>Message</th></tr></thead>
<tbody>
{% for e in samples -%}
<tr><td>{{ e.class }}</td><td><code>{{ e.file }}</code></td><td>{{ e.message }}</td></tr>
{% endfor -%}
</tbody>
</table>
{%- endif %}
{% if r.warnings -%}
<h2>Warnings</h2>
<ul>
{% for w in r.warnings %}<li>{{ w }}</li>
{% endfor -%}
</ul>
{%- endif %}
{%- elif kind == "stress" -%}
<dl class="meta">
<dt>Target</dt><dd><code>{{ r.target }}</code></dd>
<dt>Environment</dt><dd>{{ r.environment or "none" }}</dd>
<dt>Mode</dt><dd>{{ r.mode }}</dd>
<dt>Seed</dt><dd>{{ r.seed }}</dd>
<dt>SLOs</dt><dd>{% for s in r.slos %}<code>{{ s }}</code>{% if not loop.last %}, {% endif %}{% else %}none{% endfor %}</dd>
<dt>Started</dt><dd>{{ r.started_at }}</dd>
<dt>Duration</dt><dd>{{ duration }}</dd>
{% if r.killed %}<dt>Killed</dt><dd class="status-failed">{{ r.killed.message }}</dd>{% endif %}
<dt>Recovery</dt><dd>{{ recovery }}</dd>
</dl>

<h2>Summary</h2>
<p>{{ r.summary.requests }} valid requests, {{ r.summary.fuzzed_requests }} fuzzed. Findings by severity: {{ counts }}.</p>
{% if breakpoint -%}
<ul class="thresholds">
{% for line in breakpoint %}<li>{{ line }}</li>
{% endfor -%}
</ul>
{%- endif %}
{% if r.rate_limited_at %}<p>Rate limited at {{ "%.2f" | format(r.rate_limited_at) }} req/s.</p>{% endif %}

{% for c in charts -%}
<h2>{{ c.title }}</h2>
<figure class="chart">
<svg viewBox="-4 -4 {{ c.chart.width + 8 }} {{ c.chart.height + 8 }}" preserveAspectRatio="none" role="img" aria-label="{% for l in c.chart.lines %}{{ l.name }}{% if not loop.last %}, {% endif %}{% endfor %}">
<line class="axis" x1="0" y1="{{ c.chart.height }}" x2="{{ c.chart.width }}" y2="{{ c.chart.height }}"/>
{% if c.chart.marker is not none %}<line class="marker" x1="{{ c.chart.marker }}" y1="0" x2="{{ c.chart.marker }}" y2="{{ c.chart.height }}"><title>breaking_rps</title></line>
{% endif -%}
{% for l in c.chart.lines -%}
<polyline class="line line-{{ l.name }}" points="{{ l.points }}"/>
{% endfor -%}
</svg>
<figcaption><span class="muted">top {{ c.chart.top }}, up to {{ c.chart.end }}</span>{% for l in c.chart.lines %} <span class="key line-{{ l.name }}">{{ l.name }}</span>{% endfor %}{% if c.chart.marker is not none %} <span class="key line-errors">breakpoint</span>{% endif %}</figcaption>
</figure>
{% endfor %}

{% if steps -%}
<h2>Steps</h2>
<table>
<thead><tr><th class="n">Offered</th><th class="n">Achieved</th><th class="n">p50</th><th class="n">p95</th><th class="n">p99</th><th>Errors</th><th>Verdict</th></tr></thead>
<tbody>
{% for row in steps -%}
<tr><td class="n">{{ "%.2f" | format(row.s.offered_rps) }}</td><td class="n">{{ "%.2f" | format(row.s.achieved_rps) }}</td><td class="n">{{ "%.2f" | format(row.s.p50_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.p95_ms) }}</td><td class="n">{{ "%.2f" | format(row.s.p99_ms) }}</td><td>{{ row.error_rate }}{% if row.errors %} <span class="muted">({{ row.errors }})</span>{% endif %}</td><td>{{ row.s.verdict }}{% if row.s.failure_mode %} ({{ row.s.failure_mode }}){% endif %}</td></tr>
{% endfor -%}
</tbody>
</table>
{%- endif %}

<h2>Findings</h2>
{% for f in findings -%}
<details class="finding">
<summary><span class="sev sev-{{ f.severity }}">{{ f.severity }}</span> <span>{{ f.id }}</span> <strong>{{ f.rule }}</strong> <span class="op">{{ f.operation }}</span></summary>
<div>
<p>{{ f.message }}</p>
{% if f.minimized %}<p>{% if f.minimized.load_dependent %}Load-dependent: the input did not fail alone.{% elif f.minimized.body %}Minimized ({{ f.minimized.replays }} replays): <code>{{ f.minimized.body }}</code>{% endif %}</p>{% endif %}
<pre>{{ f.evidence.method }} {{ f.evidence.url }}
{% for h in f.evidence.request_headers %}{{ h[0] }}: {{ h[1] }}
{% endfor %}{% if f.evidence.request_body %}
{{ f.evidence.request_body }}{% endif %}</pre>
</div>
</details>
{% else -%}
<p>No findings.</p>
{% endfor -%}
{% if r.warnings -%}
<h2>Warnings</h2>
<ul>
{% for w in r.warnings %}<li>{{ w }}</li>
{% endfor -%}
</ul>
{%- endif %}
{%- else -%}
<dl class="meta">
<dt>Started</dt><dd>{{ r.started_at }}</dd>
<dt>Environment</dt><dd>{{ r.environment or "none" }}</dd>
<dt>Duration</dt><dd>{{ duration }}</dd>
{% if r.summary.interrupted %}<dt>Interrupted</dt><dd>yes: the results are partial</dd>{% endif %}
</dl>

<h2>Summary</h2>
<table>
<thead><tr><th class="n">Total</th><th class="n">Passed</th><th class="n">Failed</th><th class="n">Errored</th><th class="n">Skipped</th></tr></thead>
<tbody><tr><td class="n">{{ r.summary.total }}</td><td class="n">{{ r.summary.passed }}</td><td class="n">{{ r.summary.failed }}</td><td class="n">{{ r.summary.errored }}</td><td class="n">{{ r.summary.skipped }}</td></tr></tbody>
</table>

<h2>Requests</h2>
{% for q in requests -%}
<details class="finding">
<summary><span class="sev status-{{ q.status }}">{{ q.status }}</span> <strong>{{ q.name }}</strong> <span class="op">{{ q.exchange }}</span> <span class="muted">{{ q.duration }}</span></summary>
<div>
<p class="muted"><code>{{ q.file }}</code></p>
{% if q.reasons %}<ul>{% for reason in q.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% endif %}
</div>
</details>
{% endfor -%}
{%- endif %}
</body>
</html>
