{
  "run_report": {
    "description": "A `rustman run` (or `rustman send`) report.",
    "type": "object",
    "required": [
      "schema",
      "kind",
      "rustman_version",
      "started_at",
      "environment",
      "summary",
      "requests"
    ],
    "properties": {
      "schema": {
        "const": "rustman.report/v1"
      },
      "kind": {
        "const": "run"
      },
      "rustman_version": {
        "type": "string"
      },
      "started_at": {
        "type": "string",
        "format": "date-time"
      },
      "environment": {
        "type": [
          "string",
          "null"
        ]
      },
      "summary": {
        "$ref": "#/$defs/summary"
      },
      "requests": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/request"
        }
      }
    }
  },
  "count": {
    "type": "integer",
    "minimum": 0
  },
  "ms": {
    "type": "number",
    "minimum": 0
  },
  "optional_ms": {
    "type": [
      "number",
      "null"
    ],
    "minimum": 0
  },
  "summary": {
    "type": "object",
    "required": [
      "total",
      "passed",
      "failed",
      "errored",
      "skipped",
      "duration_ms",
      "interrupted"
    ],
    "properties": {
      "total": {
        "$ref": "#/$defs/count"
      },
      "passed": {
        "$ref": "#/$defs/count"
      },
      "failed": {
        "$ref": "#/$defs/count"
      },
      "errored": {
        "$ref": "#/$defs/count"
      },
      "skipped": {
        "$ref": "#/$defs/count"
      },
      "duration_ms": {
        "$ref": "#/$defs/ms"
      },
      "interrupted": {
        "type": "boolean",
        "description": "Stopped by Ctrl+C; the requests are partial."
      },
      "snapshots": {
        "$ref": "#/$defs/snapshot_counts"
      }
    }
  },
  "request": {
    "type": "object",
    "required": [
      "id",
      "name",
      "file",
      "iteration",
      "status",
      "skip_reason",
      "error",
      "exchange",
      "assertions",
      "captures",
      "warnings",
      "duration_ms"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "file": {
        "type": "string"
      },
      "iteration": {
        "type": "integer",
        "minimum": 1
      },
      "data_row": {
        "$ref": "#/$defs/data_row"
      },
      "status": {
        "enum": [
          "passed",
          "failed",
          "errored",
          "skipped"
        ]
      },
      "skip_reason": {
        "enum": [
          "bail",
          "interrupted",
          "unsupported_kind",
          null
        ]
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "exchange": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/exchange"
          }
        ]
      },
      "jsonrpc": {
        "$ref": "#/$defs/jsonrpc"
      },
      "assertions": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/assertion"
        }
      },
      "captures": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/capture"
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "duration_ms": {
        "$ref": "#/$defs/ms"
      }
    }
  },
  "jsonrpc": {
    "type": "object",
    "description": "The JSON-RPC side of a kind: jsonrpc request: the envelopes sent and received per call, every HTTP attempt, and a subscription's events (the first 1000). Absent from every other request. Added in v0.5.",
    "required": [
      "transport",
      "batch",
      "calls",
      "elapsed_ms"
    ],
    "properties": {
      "transport": {
        "enum": [
          "http",
          "ws"
        ]
      },
      "batch": {
        "type": "boolean"
      },
      "calls": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "method",
            "id",
            "request",
            "response",
            "outcome"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "id": {
              "description": "The id sent; null for a notification."
            },
            "request": {
              "type": "object",
              "description": "The envelope sent."
            },
            "response": {
              "description": "The envelope that answered this call, or null."
            },
            "outcome": {
              "enum": [
                "result",
                "error",
                "notification",
                "failed"
              ]
            },
            "failure": {
              "type": "string"
            }
          }
        }
      },
      "attempts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "status",
            "error",
            "elapsed_ms"
          ],
          "properties": {
            "status": {
              "type": [
                "integer",
                "null"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "elapsed_ms": {
              "$ref": "#/$defs/ms"
            },
            "retry_in_ms": {
              "$ref": "#/$defs/ms"
            }
          }
        }
      },
      "subscription": {
        "type": "object",
        "required": [
          "subscription_id",
          "event_count",
          "events",
          "ended",
          "unsubscribed",
          "elapsed_ms"
        ],
        "properties": {
          "subscription_id": {},
          "event_count": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "maxItems": 1000
          },
          "ended": {
            "enum": [
              "max_events",
              "duration",
              "stopped",
              "closed"
            ]
          },
          "unsubscribed": {
            "type": "boolean"
          },
          "elapsed_ms": {
            "$ref": "#/$defs/ms"
          }
        }
      },
      "note": {
        "type": "string"
      },
      "refusal": {
        "enum": [
          "validation",
          "guard"
        ]
      },
      "elapsed_ms": {
        "$ref": "#/$defs/ms"
      }
    }
  },
  "data_row": {
    "type": "object",
    "description": "The data row a data-driven (--data) run used; absent from every run without --data (--iterations included). Added in v0.2.",
    "required": [
      "index",
      "total",
      "label"
    ],
    "properties": {
      "index": {
        "type": "integer",
        "minimum": 1
      },
      "total": {
        "type": "integer",
        "minimum": 1
      },
      "label": {
        "type": "string",
        "description": "The --data-label column's value, else row <index>."
      }
    }
  },
  "header": {
    "type": "object",
    "required": [
      "name",
      "value"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "value": {
        "type": "string"
      }
    }
  },
  "headers": {
    "type": "array",
    "items": {
      "$ref": "#/$defs/header"
    }
  },
  "exchange": {
    "type": "object",
    "required": [
      "request",
      "response",
      "timings",
      "redirects",
      "insecure"
    ],
    "properties": {
      "request": {
        "type": "object",
        "required": [
          "method",
          "url",
          "headers",
          "body"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "headers": {
            "$ref": "#/$defs/headers"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "status",
          "http_version",
          "headers",
          "body",
          "body_bytes",
          "body_truncated",
          "binary"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 999
          },
          "http_version": {
            "enum": [
              "HTTP/1.0",
              "HTTP/1.1",
              "HTTP/2"
            ]
          },
          "headers": {
            "$ref": "#/$defs/headers"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "body_bytes": {
            "$ref": "#/$defs/count"
          },
          "body_truncated": {
            "type": "boolean"
          },
          "binary": {
            "type": "boolean"
          }
        }
      },
      "timings": {
        "type": "object",
        "required": [
          "dns_ms",
          "connect_ms",
          "tls_ms",
          "ttfb_ms",
          "download_ms",
          "total_ms"
        ],
        "properties": {
          "dns_ms": {
            "$ref": "#/$defs/optional_ms"
          },
          "connect_ms": {
            "$ref": "#/$defs/optional_ms"
          },
          "tls_ms": {
            "$ref": "#/$defs/optional_ms"
          },
          "ttfb_ms": {
            "$ref": "#/$defs/ms"
          },
          "download_ms": {
            "$ref": "#/$defs/ms"
          },
          "total_ms": {
            "$ref": "#/$defs/ms"
          },
          "auth_ms": {
            "$ref": "#/$defs/ms"
          }
        }
      },
      "redirects": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "status",
            "url"
          ],
          "properties": {
            "status": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            }
          }
        }
      },
      "insecure": {
        "type": "boolean"
      }
    }
  },
  "assertion": {
    "type": "object",
    "required": [
      "kind",
      "outcome",
      "label",
      "expected",
      "actual",
      "message"
    ],
    "properties": {
      "kind": {
        "enum": [
          "status",
          "header",
          "json",
          "schema",
          "body",
          "latency",
          "no_errors",
          "errors_count",
          "error_message_contains",
          "error_code",
          "data",
          "rpc_error",
          "snapshot"
        ]
      },
      "outcome": {
        "enum": [
          "pass",
          "fail",
          "error"
        ]
      },
      "label": {
        "type": "string"
      },
      "expected": {
        "type": [
          "string",
          "null"
        ]
      },
      "actual": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": "string"
      },
      "snapshot": {
        "$ref": "#/$defs/snapshot_result"
      }
    }
  },
  "capture": {
    "type": "object",
    "required": [
      "var",
      "outcome",
      "message",
      "required",
      "persisted",
      "secret"
    ],
    "properties": {
      "var": {
        "type": "string"
      },
      "outcome": {
        "enum": [
          "captured",
          "no_match",
          "error"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "required": {
        "type": "boolean"
      },
      "persisted": {
        "type": "boolean"
      },
      "secret": {
        "type": "boolean"
      }
    }
  },
  "snapshot_counts": {
    "description": "How the run's snapshot assertions ended; absent when the run had none.",
    "type": "object",
    "required": [
      "matched",
      "recorded",
      "updated",
      "failed",
      "missing"
    ],
    "properties": {
      "matched": {
        "$ref": "#/$defs/count"
      },
      "recorded": {
        "$ref": "#/$defs/count"
      },
      "updated": {
        "$ref": "#/$defs/count"
      },
      "failed": {
        "$ref": "#/$defs/count"
      },
      "missing": {
        "$ref": "#/$defs/count"
      }
    }
  },
  "snapshot_result": {
    "description": "The outcome of a `snapshot` assertion. Every value is redacted.",
    "type": "object",
    "required": [
      "name",
      "state",
      "path"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "state": {
        "enum": [
          "matched",
          "recorded",
          "updated",
          "failed",
          "missing"
        ]
      },
      "path": {
        "type": "string",
        "description": "The snapshot file, relative to the workspace, with `/`."
      },
      "diff": {
        "$ref": "#/$defs/snapshot_diff"
      }
    }
  },
  "snapshot_diff": {
    "description": "The differences from the stored snapshot.",
    "type": "object",
    "required": [
      "changes",
      "more"
    ],
    "properties": {
      "changes": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "$ref": "#/$defs/snapshot_change"
        }
      },
      "more": {
        "$ref": "#/$defs/count"
      },
      "text": {
        "type": "string",
        "description": "The unified diff of text bodies."
      },
      "binary": {
        "type": "object",
        "required": [
          "old_size",
          "old_sha256",
          "new_size",
          "new_sha256"
        ],
        "properties": {
          "old_size": {
            "$ref": "#/$defs/count"
          },
          "old_sha256": {
            "type": "string"
          },
          "new_size": {
            "$ref": "#/$defs/count"
          },
          "new_sha256": {
            "type": "string"
          }
        }
      },
      "event_count": {
        "type": "object",
        "required": [
          "old",
          "new"
        ],
        "properties": {
          "old": {
            "$ref": "#/$defs/count"
          },
          "new": {
            "$ref": "#/$defs/count"
          }
        }
      },
      "body_type": {
        "type": "object",
        "required": [
          "old",
          "new"
        ],
        "properties": {
          "old": {
            "type": "string"
          },
          "new": {
            "type": "string"
          }
        }
      }
    }
  },
  "snapshot_change": {
    "type": "object",
    "required": [
      "path",
      "kind"
    ],
    "properties": {
      "path": {
        "type": "string",
        "description": "A JSONPath into the body, or `status` or `headers.<name>`."
      },
      "kind": {
        "enum": [
          "added",
          "removed",
          "changed"
        ]
      },
      "old": {},
      "new": {}
    }
  }
}
