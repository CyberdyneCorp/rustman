<!-- Bench dashboard (rustman bench --viz, issue #123). Slots named here
     are filled by the code: Labels get text, empty VBoxes get a chart,
     plot or table. -->
<Window Title="Rustman · Bench" Width="1280" Height="860" MinWidth="900" MinHeight="600">
  <VBox Spacing="14" Slot.Padding="18">
    <HBox Spacing="12">
      <VBox Spacing="2" Slot.Fill="1">
        <Label Name="title" Text="Bench" TextSize="22"/>
        <Label Name="subtitle" Text="" Color="#8A93A6"/>
      </VBox>
      <Border Padding="8,4" CornerRadius="12" Slot.VAlign="Center">
        <Label Name="state" Text="Running"/>
      </Border>
    </HBox>
    <UniformGrid Columns="5" Spacing="12">
      <Border Padding="12" CornerRadius="10">
        <VBox Spacing="4">
          <Label Text="Requests" Color="#8A93A6"/>
          <Label Name="kpi_requests" Text="0" TextSize="26"/>
          <VBox Name="spark_requests" Height="34"/>
        </VBox>
      </Border>
      <Border Padding="12" CornerRadius="10">
        <VBox Spacing="4">
          <Label Text="Requests per second" Color="#8A93A6"/>
          <Label Name="kpi_rps" Text="–" TextSize="26"/>
          <VBox Name="spark_rps" Height="34"/>
        </VBox>
      </Border>
      <Border Padding="12" CornerRadius="10">
        <VBox Spacing="4">
          <Label Text="p95 latency" Color="#8A93A6"/>
          <Label Name="kpi_p95" Text="–" TextSize="26"/>
          <VBox Name="spark_p95" Height="34"/>
        </VBox>
      </Border>
      <Border Padding="12" CornerRadius="10">
        <VBox Spacing="4">
          <Label Text="Error rate" Color="#8A93A6"/>
          <Label Name="kpi_error_rate" Text="–" TextSize="26"/>
          <VBox Name="spark_error_rate" Height="34"/>
        </VBox>
      </Border>
      <Border Padding="12" CornerRadius="10">
        <VBox Spacing="4">
          <Label Text="Active VUs" Color="#8A93A6"/>
          <Label Name="kpi_vus" Text="–" TextSize="26"/>
          <VBox Name="spark_vus" Height="34"/>
        </VBox>
      </Border>
    </UniformGrid>
    <HBox Spacing="12" Slot.Fill="3">
      <Border Padding="12" CornerRadius="10" Slot.Fill="1">
        <VBox Spacing="6">
          <Label Text="Throughput per second" Color="#8A93A6"/>
          <VBox Name="throughput" Slot.Fill="1"/>
        </VBox>
      </Border>
      <Border Padding="12" CornerRadius="10" Slot.Fill="1">
        <VBox Spacing="6">
          <Label Text="Latency percentiles per second" Color="#8A93A6"/>
          <VBox Name="latency" Slot.Fill="1"/>
        </VBox>
      </Border>
    </HBox>
    <HBox Spacing="12" Slot.Fill="2">
      <Border Padding="12" CornerRadius="10" Slot.Fill="1">
        <VBox Spacing="6">
          <Label Text="Active VUs" Color="#8A93A6"/>
          <VBox Name="vus" Slot.Fill="1"/>
        </VBox>
      </Border>
      <Border Padding="12" CornerRadius="10" Width="300">
        <VBox Spacing="6">
          <Label Text="Totals" Color="#8A93A6"/>
          <VBox Name="summary" Slot.Fill="1"/>
        </VBox>
      </Border>
      <Border Padding="12" CornerRadius="10" Slot.Fill="1">
        <VBox Spacing="6">
          <Label Name="thresholds_heading" Text="Thresholds" Color="#8A93A6"/>
          <VBox Name="thresholds" Slot.Fill="1"/>
        </VBox>
      </Border>
    </HBox>
  </VBox>
</Window>
