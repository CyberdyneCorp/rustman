---
source: crates/rustman-cli/src/tests.rs
expression: "&script[start..end]"
---
(rpc)
_arguments "${_arguments_options[@]}" : \
'--color=[Color\: auto (a terminal without NO_COLOR or TERM=dumb), always or never]:WHEN:((auto\:"Color a terminal, unless NO_COLOR is set or TERM=dumb"
always\:"Color even when piped"
never\:"Never color"))' \
'*-v[Log more on stderr\: -v requests, -vv headers, -vvv everything (RUST_LOG, when set, replaces these levels)]' \
'*--verbose[Log more on stderr\: -v requests, -vv headers, -vvv everything (RUST_LOG, when set, replaces these levels)]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_rustman__subcmd__rpc_commands" \
"*::: :->rpc" \
&& ret=0

    case $state in
    (rpc)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rustman-rpc-command-$line[1]:"
        case $line[1] in
            (call)
_arguments "${_arguments_options[@]}" : \
'()*--param=[A typed param of a built-in eth_*, net_* or web3_* method (repeatable)\: --param address=0xd8dA... --param block=latest]:NAME=VALUE:_default' \
'*-H+[Add a header (repeatable)\: --header "Authorization\: Basic {{auth}}"]:NAME: VALUE:_default' \
'*--header=[Add a header (repeatable)\: --header "Authorization\: Basic {{auth}}"]:NAME: VALUE:_default' \
'(--notify)--id=[Send this id instead of 1 (an integer, or else a string)]:ID:_default' \
'--subscribe=[Subscribe\: METHOD is the subscribe method and this the notification method (needs --unsubscribe and a ws\:// or wss\:// endpoint)]:NOTIFICATION:_default' \
'--unsubscribe=[The method that ends a subscription]:METHOD:_default' \
'--max-events=[Subscriptions stop after N events (default\: the request'\''s max_events, else 10)]:N:_default' \
'--duration=[Subscriptions stop after this long (default\: the request'\''s max_duration_ms, else 30s)]:DURATION:_default' \
'--env=[Environment (default\: RUSTMAN_ENV, then default_environment)]:NAME:_default' \
'--workspace=[Workspace directory (default\: search from the current directory upwards)]:DIR:_files' \
'*--var=[Set a variable, above every other source (repeatable)\: --var k=v]:K=V:_default' \
'--timeout=[Total timeout per request, replacing settings.timeout_ms\: 500ms, 5s, 2m, or a number of milliseconds]:DURATION:_default' \
'--color=[Color\: auto (a terminal without NO_COLOR or TERM=dumb), always or never]:WHEN:((auto\:"Color a terminal, unless NO_COLOR is set or TERM=dumb"
always\:"Color even when piped"
never\:"Never color"))' \
'--notify[Send a notification\: no id, no response expected]' \
'--no-validate[Send even when the call does not match the endpoint'\''s OpenRPC catalog]' \
'(--json)--raw[Print the response envelopes as received (redacted)]' \
'--json[Print the whole exchange as one JSON object]' \
'-k[Do not verify TLS certificates (exchanges are flagged insecure)]' \
'--insecure[Do not verify TLS certificates (exchanges are flagged insecure)]' \
'--no-history[Do not record the exchanges in history]' \
'--trace[Send trace context (traceparent) even when no trace block enables it]' \
'-u[Overwrite snapshots that differ from the response (not in CI mode)]' \
'--update-snapshots[Overwrite snapshots that differ from the response (not in CI mode)]' \
'--ci[CI mode\: never write snapshots, and fail on a missing one (also on when the CI variable is true or 1)]' \
'*-v[Log more on stderr\: -v requests, -vv headers, -vvv everything (RUST_LOG, when set, replaces these levels)]' \
'*--verbose[Log more on stderr\: -v requests, -vv headers, -vvv everything (RUST_LOG, when set, replaces these levels)]' \
'-h[Print help]' \
'--help[Print help]' \
':target -- An endpoint URL (http, https, ws, wss, or a {{variable}}), or a jsonrpc request file, its id or its name:_default' \
'::method -- The method to call (with an endpoint):_default' \
'::params -- The params, as a JSON array or object:_default' \
&& ret=0
;;
