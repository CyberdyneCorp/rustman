_arguments "${_arguments_options[@]}" : \
'--to=[The contract\: an address or ENS name (an ad-hoc call)]:ADDRESS:_default' \
'--abi=[The ABI of an ad-hoc call\: erc20, erc721, erc1155 or a path from the workspace root]:ABI:_default' \
'--function=[The function of an ad-hoc call\: a name or a full signature]:FUNCTION:_default' \
'--block=[The block\: latest, finalized, a number or a hash (ad-hoc calls)]:BLOCK:_default' \
