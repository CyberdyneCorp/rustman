---
source: crates/rustman-mcp/tests/tools_list.rs
expression: render(&tools)
---
list_requests [read-only] (collection, kind, text, cursor, limit)
get_request [read-only] (path*)
list_environments [read-only] ()
select_environment [read-only] (name*)
send_request [sends] (path, vars, method, url, headers, body, timeout_ms)
run_collection [sends] (path, filter, vars, bail)
import_openapi [writes] (spec*, into, dry_run)
explore_plan [read-only] (spec*, target*, probes, operations, seed, fuzz_cases, allow_mutations, allow_destructive, cursor, limit)
explore_run [sends] (spec*, target*, probes, operations, seed, fuzz_cases, allow_mutations, allow_destructive, cursor, limit, max_probes, max_duration_ms, fail_on)
explore_status [read-only] (id)
explore_cancel [writes] (job_id*)
get_report [read-only] (id, format)
list_findings [read-only] (exploration_id, severity, operation, cursor, limit)
search_history [read-only] (url, method, status, since, until, cursor, limit)
rpc_call [sends] (path, endpoint, method, params, vars, timeout_ms)
realtime_listen [sends] (path, url, frames, max_messages, duration_ms, vars)
graphql_introspect [read-only] (endpoint, path, type_name, refresh, vars)
graphql_query [sends] (path, endpoint, query, operation_name, variables, headers, vars, timeout_ms)
list_webhook_captures [read-only] (path, method, verdict, since, cursor, limit)
grpc_list [read-only] (target, path, refresh, vars)
grpc_describe [read-only] (target, path, symbol*, refresh, vars)
grpc_call [sends] (path, target, method, message, metadata, deadline_ms, vars)
evm_call [read-only] (path, rpc, to, abi, function, args, block, from, estimate, vars)
evm_decode [read-only] (abi*, data*, topics)
evm_tx [read-only] (hash*, rpc, vars)
evm_block [read-only] (block, rpc, vars)
evm_logs_query [read-only] (from_block*, to_block, addresses, event, topics, rpc, vars)
evm_ens [read-only] (target*, rpc, vars)
